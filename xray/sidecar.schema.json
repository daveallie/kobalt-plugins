{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daveallie/kobalt-plugins/xray/sidecar.schema.json",
  "title": "Kobalt X-Ray sidecar",
  "type": "object",
  "required": ["format", "characters"],
  "properties": {
    "format": { "const": "kobalt-xray/1" },
    "book": {
      "type": "object",
      "description": "Informational only. X-Ray does not check it against the open book.",
      "properties": {
        "title": { "type": "string" },
        "series": { "type": "string" },
        "number": { "type": "number" }
      }
    },
    "characters": {
      "type": "array",
      "items": { "$ref": "#/$defs/character" }
    }
  },
  "$defs": {
    "at": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percent of this book, by word count. Use the percentage at the END of the chapter where the fact is revealed. 0 means known from the start."
    },
    "character": {
      "type": "object",
      "required": ["id", "name", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Unique within the file." },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "summary": {
          "type": "array",
          "minItems": 1,
          "description": "The earliest entry decides when the character becomes known.",
          "items": {
            "type": "object",
            "required": ["at", "text"],
            "properties": { "at": { "$ref": "#/$defs/at" }, "text": { "type": "string" } }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "with", "text"],
            "properties": {
              "at": { "$ref": "#/$defs/at" },
              "with": { "type": "string", "description": "The id of another character." },
              "text": { "type": "string" }
            }
          }
        },
        "appearances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "where"],
            "properties": { "at": { "$ref": "#/$defs/at" }, "where": { "type": "string" } }
          }
        }
      }
    }
  }
}
